#!/bin/bash

root_issuer_name=$(date +root-%Y)
vault_address=http://172.17.0.1:8200

build_root_ca() {
  # Enable the PKI secret engine on the `/pki` mount path.
  vault secrets enable pki

  # Tweak certificate lifespan to 10y.
  vault secrets tune -max-lease-ttl=87600h pki

  # Generates a new self-signed root CA certificate and save it under `./root_ca.crt`.
  vault write -field=certificate pki/root/generate/internal \
    common_name="home" \
    issuer_name="$root_issuer_name" \
    ttl=87600h >root_ca.crt

  # Configure the cluster path and AIA path (Required by the ACME feature).
  vault write pki/config/cluster \
    path=$vault_address/v1/pki \
    aia_path=$vault_address/v1/pki

  # Create the role that will be used for issuing certificates from the Root CA.
  vault write pki/roles/servers \
    allow_any_name=true \
    no_store=false

  # Configure the issuing certificate endpoints, CRL distribution points, and OCSP server endpoints that
  # will be encoded into issued certificates
  vault write pki/config/urls \
    issuing_certificates={{cluster_aia_path}}/issuer/{{issuer_id}}/der \
    crl_distribution_points={{cluster_aia_path}}/issuer/{{issuer_id}}/crl/der \
    ocsp_servers={{cluster_path}}/ocsp \
    enable_templating=true
}

build_intermediate_acme_ca() {
  # Enable the PKI secret engine on the `/pki_int` mount path.
  vault secrets enable -path=pki_int pki

  # Tweak certificate lifespan to 5y, shorter than the root CA.
  vault secrets tune -max-lease-ttl=43800h pki_int

  # Generate an intermediate certificate and save the CSR under `./pki_intermediate.csr`.
  vault write -format=json pki_int/intermediate/generate/internal \
    common_name="home Vault Intermediate Authority" \
    issuer_name="intermediate" \
    | jq -r '.data.csr' >pki_intermediate.csr

  # Sign the intermediate certificate with the root CA private key, and save the generated certificate
  # under `./intermediate.cert.pem`.
  vault write -format=json pki/root/sign-intermediate \
    issuer_ref="$root_issuer_name" \
    csr=@pki_intermediate.csr \
    format=pem_bundle ttl="43800h" \
    | jq -r '.data.certificate' >intermediate.cert.pem

  # Imported the signed intermediate certificate.
  vault write pki_int/intermediate/set-signed \
    certificate=@intermediate.cert.pem

  # Configure the cluster path and AIA path (Required by the ACME feature).
  vault write pki_int/config/cluster \
    path=$vault_address/v1/pki_int \
    aia_path=$vault_address/v1/pki_int

  # Create the role that will be used for issuing certificates from the Intermediate CA.
  vault write pki_int/roles/intermediate \
    issuer_ref="$(vault read -field=default pki_int/config/issuers)" \
    allow_any_name=true \
    max_ttl="768h" \
    no_store=false

  # Configure the issuing certificate endpoints, CRL distribution points, and OCSP server endpoints that
  # will be encoded into issued certificates.
  vault write pki_int/config/urls \
    issuing_certificates={{cluster_aia_path}}/issuer/{{issuer_id}}/der \
    crl_distribution_points={{cluster_aia_path}}/issuer/{{issuer_id}}/crl/der \
    ocsp_servers={{cluster_path}}/ocsp \
    enable_templating=true

  # Configure the pki_int engine so it handle ACME requests correctly.
  vault secrets tune \
    -passthrough-request-headers=If-Modified-Since \
    -allowed-response-headers=Last-Modified \
    -allowed-response-headers=Location \
    -allowed-response-headers=Replay-Nonce \
    -allowed-response-headers=Link \
    pki_int

  vault write pki_int/config/acme enabled=true
}

build_intermediate_internal_ca() {
  # Enable the PKI secret engine on the `/pki_int` mount path.
  vault secrets enable -path=pki_int_internal pki

  # Tweak certificate lifespan to 5y, shorter than the root CA.
  vault secrets tune -max-lease-ttl=43800h pki_int_internal

  # Generate an intermediate certificate and save the CSR under `./pki_int_internalermediate.csr`.
  vault write -format=json pki_int_internal/intermediate/generate/internal \
    common_name="home Vault Intermediate Authority" \
    issuer_name="intermediate" \
    | jq -r '.data.csr' >pki_int_internalermediate.csr

  # Sign the intermediate certificate with the root CA private key, and save the generated certificate
  # under `./intermediate.cert.pem`.
  vault write -format=json pki/root/sign-intermediate \
    issuer_ref="$root_issuer_name" \
    csr=@pki_int_internalermediate.csr \
    format=pem_bundle ttl="43800h" \
    | jq -r '.data.certificate' >intermediate.cert.pem

  # Imported the signed intermediate certificate.
  vault write pki_int_internal/intermediate/set-signed \
    certificate=@intermediate.cert.pem

  vault write pki_int_internal/config/cluster \
    path=$vault_address/v1/pki_int_internal \
    aia_path=$vault_address/v1/pki_int_internal

  # Create the role that will be used for issuing certificates from the Intermediate CA.
  vault write pki_int_internal/roles/intermediate \
    issuer_ref="$(vault read -field=default pki_int_internal/config/issuers)" \
    allow_any_name=true \
    max_ttl="4380h" \
    no_store=true

  vault write pki_int_internal/config/urls \
    issuing_certificates={{cluster_aia_path}}/issuer/{{issuer_id}}/der \
    crl_distribution_points={{cluster_aia_path}}/issuer/{{issuer_id}}/crl/der \
    ocsp_servers={{cluster_path}}/ocsp \
    enable_templating=true
}

if vault read sys/mounts/pki &>/dev/null ||; then
  echo "ERROR: refusing to run when the pki secrets engine already exists"
  exit 1
fi

if vault read sys/mounts/pki_int &>/dev/null ||; then
  echo "ERROR: refusing to run when the pki_int secrets engine already exists"
  exit 1
fi

build_root_ca
build_intermediate_acme_ca
build_intermediate_internal_ca
