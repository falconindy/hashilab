#!/bin/bash
#
# tofu-secrets — generate tofu/secrets.auto.tfvars from the Pocket-ID OIDC client
# credentials stored in Vault, so you never hand-copy them.
#
# Expects a KV v2 mount `kv` laid out as:
#   kv/pocket-id/vault  -> fields: oidc_client_id, oidc_client_secret   (Vault client)
#   kv/pocket-id/nomad  -> fields: oidc_client_id, oidc_client_secret   (Nomad client)
#
# Run with a Vault token that can read those paths:
#   vault login -method=oidc
#   export VAULT_ADDR=https://vault.service.home:8200
#   bin/tofu-secrets
#
# Overwrites tofu/secrets.auto.tfvars each run — Vault is the source of truth.

vault token lookup >/dev/null 2>&1 || {
  echo "ERROR: no valid Vault token — run 'vault login -method=oidc' first" >&2
  exit 1
}

script_dir=$(cd "$(dirname "$0")" && pwd)
repo_root=$(cd "$script_dir/.." && pwd)
out="$repo_root/tofu/secrets.auto.tfvars"

{
  vault kv get -format=json kv/pocket-id/vault |
    jq -r '.data.data | [
      "vault_oidc_client_id     = \"" + .oidc_client_id + "\"",
      "vault_oidc_client_secret = \"" + .oidc_client_secret + "\""
    ][]'

  vault kv get -format=json kv/pocket-id/nomad |
    jq -r '.data.data | [
      "nomad_oidc_client_id     = \"" + .oidc_client_id + "\"",
      "nomad_oidc_client_secret = \"" + .oidc_client_secret + "\""
    ][]'
} >"$out"
