#!/usr/bin/env python3

import argparse
import json
import os
import subprocess
import sys
import time
import urllib.request
import paramiko


def run_cmd(cmd, check=True, capture_output=True, text=True):
    try:
        return subprocess.run(
            cmd, check=check, capture_output=capture_output, text=text
        )
    except subprocess.CalledProcessError as e:
        print(f"Error running command {' '.join(cmd)}: {e}")
        sys.exit(1)


def ssh_restart(host, service, dry_run=False):
    if dry_run:
        print(f"[DRY-RUN] Would restart {service} on {host}")
        return True

    print(f">>> Restarting {service} on {host}")
    client = paramiko.SSHClient()
    client.set_missing_host_key_policy(paramiko.AutoAddPolicy())
    try:
        client.connect(host)
        stdin, stdout, stderr = client.exec_command(f"sudo systemctl restart {service}")
        exit_status = stdout.channel.recv_exit_status()
        if exit_status != 0:
            err = stderr.read().decode().strip()
            print(f" ❌ ERROR: {err}")
            return False
        print(" ✓ DONE")
        return True
    except Exception as e:
        print(f" ❌ CONNECTION ERROR: {e}")
        return False
    finally:
        client.close()


def get_consul_config(addr):
    url = f"{addr}/v1/operator/raft/configuration"
    try:
        with urllib.request.urlopen(url) as response:
            return json.loads(response.read().decode())
    except Exception as e:
        print(f"Error fetching Consul config: {e}")
        sys.exit(1)


def get_consul_health(addr, node):
    url = f"{addr}/v1/health/node/{node}"
    try:
        with urllib.request.urlopen(url) as response:
            data = json.loads(response.read().decode())
            if data and len(data) > 0:
                return data[0].get("Status")
    except Exception:
        pass
    return None


def do_consul(args):
    addr = os.environ.get("CONSUL_HTTP_ADDR", "https://localhost:8501")
    config = get_consul_config(addr)

    # map(select(.Voter == true)) | sort_by(.Leader) | .[].Node
    servers = [s for s in config.get("Servers", []) if s.get("Voter")]
    servers.sort(key=lambda s: s.get("Leader", False))

    node_names = [s.get("Node") for s in servers]

    if not node_names:
        print("No voting servers found. Check your Consul connection.")
        sys.exit(1)

    print("Plan: Restarting the following voting servers (leader last):")
    for name in node_names:
        print(f" - {name}")
    print("-" * 50)

    if args.dry_run:
        return

    for node in node_names:
        host = f"{node}.node.home"
        if not ssh_restart(host, "consul"):
            sys.exit(1)

        print(f"Waiting for {node} to return as a healthy voter...")
        while True:
            # Check Raft status
            curr_config = get_consul_config(addr)
            is_voter = False
            for s in curr_config.get("Servers", []):
                if s.get("Node") == node and s.get("Voter"):
                    is_voter = True
                    break

            if is_voter:
                health = get_consul_health(addr, node)
                if health == "passing":
                    print(f"✓ {node} is back and healthy.")
                    break

            print(f"Waiting for {node}...")
            time.sleep(5)

        time.sleep(5)


def do_nomad(args):
    # Fetch servers
    res = run_cmd(["nomad", "server", "members", "-json"])
    members = json.loads(res.stdout)
    # sort_by(.Tags.Leader) | .[] | .Tags.Leader + " " + .Addr + " " + .Name
    members.sort(key=lambda m: m.get("Tags", {}).get("Leader") == "true")

    servers = []
    for m in members:
        leader_tag = m.get("Tags", {}).get("Leader") == "true"
        icon = "👑" if leader_tag else "🛡️"
        name = m.get("Name")
        addr = m.get("Addr")
        print(f"{icon}  {name} ({addr})")
        servers.append((addr, name))

    clients = []
    res = run_cmd(["nomad", "node", "status", "-json"])
    nodes = json.loads(res.stdout)
    server_addrs = [s[0] for s in servers]

    for n in nodes:
        addr = n.get("Address")
        name = n.get("Name")
        if addr not in server_addrs:
            clients.append((addr, name))
            if args.all:
                print(f"🙋  {name} ({addr})")

    print("-" * 50)

    targets = servers
    if args.all:
        targets += clients

    if args.dry_run:
        print("Plan: Restart order:")
        for addr, name in targets:
            print(f" - {name} ({addr})")
        return

    for addr, name in targets:
        if not ssh_restart(addr, "nomad"):
            sys.exit(1)


def do_vault(args):
    res = run_cmd(["vault", "operator", "raft", "list-peers", "-format=json"])
    data = json.loads(res.stdout)
    servers = data.get("data", {}).get("config", {}).get("servers", [])

    # Sort: followers first, leader last
    servers.sort(key=lambda s: s.get("leader", False))

    targets = []
    for s in servers:
        addr = s.get("address")
        # Strip port if present (e.g. 10.0.100.100:8201)
        if ":" in addr:
            addr = addr.split(":")[0]

        is_leader = s.get("leader", False)
        icon = "👑" if is_leader else "🛡️"
        print(f"{icon}  {addr}")
        targets.append(addr)

    print("-" * 50)

    if args.dry_run:
        print("Plan: Restart order:")
        for t in targets:
            print(f" - {t}")
        return

    for t in targets:
        if not ssh_restart(t, "vault"):
            sys.exit(1)


def main():
    parser = argparse.ArgumentParser(
        prog="rr", description="Rolling restart for Consul or Nomad"
    )
    parser.add_argument(
        "--dry-run",
        action="store_true",
        help="Show what would be done without doing it",
    )

    subparsers = parser.add_subparsers(dest="command", required=True)

    # Consul
    subparsers.add_parser("consul", help="Rolling restart Consul servers")

    # Nomad
    nomad_parser = subparsers.add_parser(
        "nomad", help="Rolling restart Nomad servers (and optionally clients)"
    )
    nomad_parser.add_argument(
        "-a", "--all", action="store_true", help="Also restart Nomad clients"
    )

    # Vault
    subparsers.add_parser("vault", help="Rolling restart Vault servers")

    args = parser.parse_args()

    if args.command == "consul":
        do_consul(args)
    elif args.command == "nomad":
        do_nomad(args)
    elif args.command == "vault":
        do_vault(args)


if __name__ == "__main__":
    main()
