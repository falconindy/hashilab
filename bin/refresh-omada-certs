#!/bin/bash

hostname=omada-controller.service.home
ip_san=10.0.1.99
expiration_slack_days=7

check_cert_expiry() {
  local datestr now

  datestr=$(openssl s_client -connect "$ip_san:8043" <<<Q 2>/dev/null |
      openssl x509 -noout -dates |
      awk -F= '$1 == "notAfter" { print $2 }')

  not_after_s=$(date --date="$datestr" +%s)
  now_s=$(date +%s)

  (( (not_after_s - now_s) > (86400 * expiration_slack_days) ))
}

# get rid of this requirement. keep certs in mem?
if [[ ! -w . ]]; then
  echo "ERROR: current directory is not writeable"
  exit 1
fi

if ! command -v vault; then
  echo "ERROR: no vault binary found"
  exit 1
fi

if ! vault token lookup &>/dev/null; then
  echo "ERROR: vault credentials expired"
  exit 1
fi

if check_cert_expiry; then
  echo "Certificate OK: expiration more than 7 days away."
  exit 0
else
  echo "Certificate expires soon: renewing"
fi

mntdir=$(mktemp -d)
sudo mount nasty.node.home:/volume1/omada-controller "$mntdir"
trap 'sudo umount "$mntdir" && rmdir "$mntdir"' EXIT

vault write \
    -format=json \
    pki_int/issue/intermediate \
    common_name="$hostname" \
    ip_sans="$ip_san" |
  tee out \
      >(jq -r '.data | .certificate, .ca_chain[]' >tls.crt) \
      >(jq -r '.data.private_key' >tls.key)

if (( $? != 0 )); then
  echo "ERROR: vault failed to issue new certificate"
  exit 1
fi

certmod=$(openssl x509 -noout -modulus -in tls.crt)
keymod=$(openssl rsa -noout -modulus -in tls.key)
if [[ $certmod != $keymod ]]; then
  echo "error: modulus mismatch between cert and key, not proceeding"
  exit 1
fi

sudo cp tls.{crt,key} "$mntdir/cert/" && rm tls.{crt,key}
