#!/usr/bin/env python3
#
# consul-mgmt — break-glass into a Consul *management* token.
#
# Mints a short-lived, lease-bound management token from Vault's Consul secrets
# engine (`consul/creds/mgmt`), drops you into a subshell wired to use it, and
# revokes the lease the moment that subshell exits. Vault's lease TTL is the
# backstop if this process dies without cleaning up.
#
# Day-to-day access is a scoped pocket-id login; ACL administration
# (tokens/policies/auth-methods/binding-rules) requires a management token no ACL
# policy can grant — this fills exactly that gap. See bin/vault-build-consul for
# the engine that issues these.
#
# Auth: uses your Vault operator token from $VAULT_TOKEN, falling back to the
# CLI token helper file ~/.vault-token. Run `vault login -method=oidc` first.

import argparse
import os
import subprocess
import sys
import tempfile
import time

import hvac

VAULT_ADDR = "https://vault.service.home:8200"
VAULT_CACERT = "/etc/ssl/certs/home.pem"

# Rendered into the subshell's rcfile. It stashes the token, sources ~/.bashrc
# (which would otherwise clobber CONSUL_HTTP_TOKEN), restores it, then installs a
# prompt chip that recomputes remaining lease time each render: green H:MM:SS
# while valid, blinking red EXPIRED once the TTL lapses.
RCFILE = r"""
__mgmt_tok=$CONSUL_HTTP_TOKEN
source ~/.bashrc
export CONSUL_HTTP_TOKEN=$__mgmt_tok; unset __mgmt_tok
__consul_mgmt_chip() {
  local left=$(( CONSUL_MGMT_EXPIRY - $(date +%s) ))
  if (( left > 0 )); then
    printf '\001\e[42;30m\002 CONSUL-MGMT %d:%02d:%02d \001\e[0m\002' \
      $(( left / 3600 )) $(( left % 3600 / 60 )) $(( left % 60 ))
  else
    printf '\001\e[5;41;97m\002 CONSUL-MGMT EXPIRED \001\e[0m\002'
  fi
}
PS1='$(__consul_mgmt_chip) '"$PS1"
"""


def vault_token():
    token = os.environ.get("VAULT_TOKEN")
    if token:
        return token.strip()
    try:
        with open(os.path.expanduser("~/.vault-token")) as f:
            return f.read().strip()
    except OSError:
        return None


def main():
    parser = argparse.ArgumentParser(
        description="Break-glass into a lease-bound Consul management token subshell."
    )
    parser.add_argument("--mount", default="consul", help="Vault Consul engine mount")
    parser.add_argument("--role", default="mgmt", help="Consul secrets engine role")
    args = parser.parse_args()

    if os.environ.get("CONSUL_MGMT_LEASE"):
        sys.exit("consul-mgmt: already in a management subshell")

    token = vault_token()
    if not token:
        sys.exit("consul-mgmt: no Vault token — run `vault login -method=oidc` first")

    client = hvac.Client(url=VAULT_ADDR, verify=VAULT_CACERT, token=token)

    resp = client.read(f"{args.mount}/creds/{args.role}")
    if not resp:
        sys.exit(f"consul-mgmt: empty response from {args.mount}/creds/{args.role}")

    consul_token = resp["data"]["token"]
    lease_id = resp["lease_id"]
    ttl = resp["lease_duration"]
    expiry = int(time.time()) + ttl
    print(f"consul-mgmt: minted management token (lease {lease_id}, ttl {ttl}s)")

    # A temp rcfile drives the interactive subshell. The token itself is passed
    # via the environment, never written to the rcfile.
    with tempfile.NamedTemporaryFile(
        mode="w", prefix="consul-mgmt-rc.", delete=False
    ) as rc:
        rc.write(RCFILE)
        rcpath = rc.name

    env = os.environ.copy()
    env["CONSUL_HTTP_TOKEN"] = consul_token
    env["CONSUL_MGMT_LEASE"] = lease_id
    env["CONSUL_MGMT_EXPIRY"] = str(expiry)

    try:
        subprocess.run(["bash", "--rcfile", rcpath, "-i"], env=env)
    finally:
        os.unlink(rcpath)

    # Back from the subshell, however it exited: revoke the lease, which tells
    # Vault to delete the Consul management token immediately.
    print(f"consul-mgmt: revoking lease {lease_id}")
    try:
        client.sys.revoke_lease(lease_id=lease_id)
    except Exception as e:
        print(f"consul-mgmt: WARNING revoke failed ({e}); token expires with its TTL")


if __name__ == "__main__":
    main()
