#!/bin/bash

shopt -s extglob

resolve_all() {
  {
    # loosely detect and pass through UUIDs.
    if [[ $1 == +([[:xdigit:]-]) ]]; then
      nomad alloc status-json "$1"
    else
      nomad job allocs -json "$1"
    fi
  } | jq -r '[
      .[] | select(.ClientStatus == "running") | {"\(.NodeName)": .ID}
    ] | sort | map(keys[] as $k | "\(.[$k]) \($k)")[]'
}

resolve_any() {
  # egalitarianism
  resolve_all "$1" | shuf -n 1 | awk '{ print $1 }'
}

cmd_lookupallocs() {
  resolve_all "$1"
}

cmd_diff() {
  local jobname=$(nomad run -output "$1" | jq -r .Job.Name)
  [[ $jobname ]] || return 1

  local current=$(nomad job inspect -hcl "$jobname")
  [[ $current ]] || return 1

  diff -u \
    --label "$1 (current)" <(echo "$current") \
    --label "$1 (future)" "$1"
}

cmd_prepull() {
  local images driver node nodes

  mapfile -t images < <(nomad run -output "$1" |
    jq -r '.Job.TaskGroups | map(.Tasks[].Config.image)[]')
  [[ $images ]] || return

  # This assumes the same driver for all images, but generally speaking we're
  # always using podman these days.
  driver=$(nomad run -output "$1" | jq -r '.Job.TaskGroups[0].Tasks[0].Driver')

  mapfile -t nodes < <(nomad node status -json |
    jq -r --argjson dcs "$(nomad run -output "$1" | jq '.Job.Datacenters')" \
      '[
          .[] | (. as $root | select($dcs == ["*"] or any($dcs[]; . == $root.Datacenter))) | .Name
       ] | sort | .[]')

  declare -A driver_argv=(
    [docker]="docker"
    [podman]="sudo podman"
  )

  printf 'Pulling image(s) to nodes: %s\n' "${nodes[*]}"
  printf ' * %s\n' "${images[@]}"

  declare -A logs
  for node in "${nodes[@]}"; do
    (
      if ssh "$node".node.home ${driver_argv[$driver]} pull "${images[@]}" &>/tmp/prepull.$node; then
        echo "SUCCESS: prepull done on $node"
      else
        echo "ERROR: prepull on $node failed; check /tmp/prepull.$node"
        false
      fi
    ) &
    logs[$node]=$!
  done

  local r=0
  for node in "${!logs[@]}"; do
    if wait -n "${logs[$node]}"; then
      rm "/tmp/prepull.$node"
    else
      r=1
    fi
  done

  return $r
}

cmd_endpoint() {
  local r resolved

  mapfile -t resolved < <(resolve_all "$1" | awk '{ print $1 }')
  [[ $resolved ]] || return 1

  for r in "${resolved[@]}"; do
    nomad alloc status -json "$r"  |
        jq -r '"\(.NodeName)\t" + (
            .AllocatedResources.Shared.Ports.[] |
                "\(.Label):\thttp://\(.HostIP):\(.Value)"
          )' |
        column -t
    echo
  done
}

cmd_exec() {
  local resolved

  if (( $# == 2 )); then
    resolved=$(resolve_all "$1" | awk -v h="$2" '$2 == h { print $1 }')
  else
    resolved=$(resolve_any "$1")
  fi

  [[ $resolved ]] || return 1

  nomad alloc exec -t -i "$resolved" /bin/sh
}

cmd_ui() {
  local args=()

  if [[ $1 = -show-url ]]; then
    args+=('-show-url')
  fi

  nomad ui -authenticate "${args[@]}"
}

known_commands() {
  mapfile -t commands < <(compgen -A function cmd_)	

  printf 'Known commands:\n'
  printf '\t%s\n' "${commands[@]#cmd_}"
}

declare -A aliases=(
  [la]=lookupallocs
  [ep]=endpoint
  [pp]=prepull
)

if [[ -z $1 ]]; then
  known_commands
  exit 1

fi

if [[ ${aliases["$1"]} ]]; then
  cmd=${aliases["$1"]}
else
  cmd=$1
fi

shift

if ! declare -f "cmd_$cmd" &>/dev/null; then
  printf 'no such command: %s\n' "$cmd" >&2
  known_commands
  exit 1
fi

"cmd_$cmd" "$@"
