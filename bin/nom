#!/bin/bash

shopt -s extglob

resolve_all() {
  {
    # loosely detect and pass through UUIDs.
    if [[ $1 == +([[:xdigit:]-]) ]]; then
      nomad alloc status -json "$1"
    else
      nomad job allocs -json "$1" | jq -r '.[]'
    fi
  } | jq -r '[
      select(.ClientStatus == "running") | {"\(.NodeName)": .ID}
    ] | sort | map(keys[] as $k | "\(.[$k]) \($k)")[]'
}

resolve_any() {
  # egalitarianism
  resolve_all "$1" | shuf -n 1 | awk '{ print $1 }'
}

cmd_lookupallocs() {
  resolve_all "$1"
}

cmd_diff() {
  local jobname=$(nomad run -output "$1" | jq -r .Job.Name)
  [[ $jobname ]] || return 1

  local current=$(nomad job inspect -hcl "$jobname")
  [[ $current ]] || return 1

  diff -u \
    --label "$1 (current)" <(echo "$current") \
    --label "$1 (future)" "$1"
}

cmd_prepull() {
  local images driver node nodes

  mapfile -t images < <(nomad run -output "$1" |
    jq -r '.Job.TaskGroups | map(.Tasks[].Config.image) | unique[]')
  [[ $images ]] || return

  # This assumes the same driver for all images, but generally speaking we're
  # always using docker.
  driver=$(nomad run -output "$1" | jq -r '.Job.TaskGroups[0].Tasks[0].Driver')

  mapfile -t nodes < <(nomad node status -json |
    jq -r --argjson dcs "$(nomad run -output "$1" | jq '.Job.Datacenters')" \
      '[
          .[] | (. as $root | select($dcs == ["*"] or any($dcs[]; . == $root.Datacenter))) | .Name
       ] | sort | .[]')

  declare -A driver_argv=(
    [docker]="docker"
  )

  printf 'Pulling image(s) to nodes: %s\n' "${nodes[*]}"
  printf ' * %s\n' "${images[@]}"

  declare -A logs
  for node in "${nodes[@]}"; do
    (
      if ssh "$node".node.home ${driver_argv[$driver]} pull "${images[@]}" &>/tmp/prepull.$node; then
        echo "SUCCESS: prepull done on $node"
      else
        echo "ERROR: prepull on $node failed; check /tmp/prepull.$node"
        false
      fi
    ) &
    logs[$node]=$!
  done

  local r=0
  for node in "${!logs[@]}"; do
    if wait -n "${logs[$node]}"; then
      rm "/tmp/prepull.$node"
    else
      r=1
    fi
  done

  return $r
}

cmd_prepull_and_push() {
  cmd_prepull "$1" && nomad run "$1"
}

cmd_endpoint() {
  local r resolved

  mapfile -t resolved < <(resolve_all "$1" | awk '{ print $1 }')
  [[ $resolved ]] || return 1

  for r in "${resolved[@]}"; do
    nomad alloc status -json "$r"  |
        jq -r '"\(.NodeName)\t" + (
            .AllocatedResources.Shared.Ports.[] |
                "\(.Label):\thttp://\(.HostIP):\(.Value)"
          )' |
        column -t
    echo
  done
}

cmd_exec() {
  local opts resolved host task

  while getopts h:t: opt; do
    case $opt in
      t)
        opts+=('-task' "$OPTARG")
        ;;
      h)
        host=$OPTARG
        ;;
    esac
  done
  shift $(( OPTIND -1 ))

  if [[ $host ]]; then
    resolved=$(resolve_all "$1" | awk -v h="$host" '$2 == h { print $1 }')
  else
    resolved=$(resolve_any "$1")
  fi

  [[ $resolved ]] || return 1

  shift

  nomad alloc exec "${opts[@]}" -t -i "$resolved" "${@:-/bin/sh}"
}

cmd_ui() {
  local args=()

  if [[ $SSH_CONNECTION ]] || ! command -v xdg-open || [[ $1 == -show-url ]]; then
    args+=('-show-url')
  fi

  nomad ui -authenticate "${args[@]}"
}

cmd_drain() {
  local node_id

  read -r node_id < <(nomad node status -json -filter "Name==$1" | jq -r '.[].ID')
  if [[ -z $node_id ]]; then
    printf 'ERROR: no node known by name: %s\n' "$1" >&2
    return 1
  fi

  nomad node drain -enable "$node_id"
}

cmd_undrain() {
  local node_id

  read -r node_id < <(nomad node status -json -filter "Name==$1" | jq -r '.[].ID')
  if [[ -z $node_id ]]; then
    printf 'ERROR: no node known by name: %s\n' "$1" >&2
    return 1
  fi

  nomad node eligibility -enable "$node_id"
}

cmd_stale() {
  local f

  for f in "$@"; do
    if ! cmd_diff "$f" >/dev/null; then
      printf '%s\n' "$f"
    fi
  done
}

known_commands() {
  mapfile -t commands < <(compgen -A function cmd_)

  printf 'Known commands:\n'
  printf '\t%s\n' "${commands[@]#cmd_}"
}

declare -A aliases=(
  [la]=lookupallocs
  [ep]=endpoint
  [pp]=prepull
  [ppp]=prepull_and_push
)

if [[ -z $1 ]]; then
  known_commands
  exit 1

fi

if [[ ${aliases["$1"]} ]]; then
  cmd=${aliases["$1"]}
else
  cmd=$1
fi

shift

if ! declare -f "cmd_$cmd" &>/dev/null; then
  printf 'no such command: %s\n' "$cmd" >&2
  known_commands
  exit 1
fi

"cmd_$cmd" "$@"
