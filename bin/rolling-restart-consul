#!/bin/bash

CONSUL_HTTP_ADDR="${CONSUL_HTTP_ADDR:-https://localhost:8501}"

mapfile -t SERVERS < <(curl -s "$CONSUL_HTTP_ADDR/v1/operator/raft/configuration" | jq -r '
  .Servers
  | map(select(.Voter == true))
  | sort_by(.Leader)
  | .[].Node')

if [[ -z $SERVERS ]]; then
    echo "No voting servers found. Check your Consul connection."
    exit 1
fi

echo "Plan: Restarting the following voting servers (leader last):"
echo "${SERVERS[@]}"
echo "----------------------------------------------------------"

for SERVER in ${SERVERS[@]}; do
    echo ">>> Starting maintenance on: $SERVER"

    ssh "$SERVER.node.home" "sudo systemctl restart consul"

    echo "Waiting for $SERVER to return as a healthy voter..."
    while true; do
        # Check if the node is back in the Raft configuration and marked as a Voter
        CURRENT_VOTER_STATUS=$(curl -s "$CONSUL_HTTP_ADDR/v1/operator/raft/configuration" | \
            jq -r --arg name "$SERVER" '.Servers[] | select(.Node == $name) | .Voter')

        if [[ $CURRENT_VOTER_STATUS = true ]]; then
            # Additionally, check Serf Health to ensure the agent is "alive"
            HEALTH_STATUS=$(curl -s "$CONSUL_HTTP_ADDR/v1/health/node/$SERVER" | jq -r '.[0].Status')

            if [[ $HEALTH_STATUS = passing ]]; then
                echo "✓ $SERVER is back and healthy."
                break
            fi
        fi

        echo "Waiting for $SERVER..."
        sleep 5
    done

    # Give the cluster a moment to stabilize before moving to the next node
    sleep 5
done
