#!/bin/bash
#
# nomad-build-oidc — enable OIDC auth in Nomad, backed by Pocket-ID, so you can
# `nomad login -method=pocket-id` (passkey in a browser) and get a client token
# bound to the `admin` policy instead of carrying the static bootstrap token.
#
# This binds to a POLICY, not a management token: the resulting token can do all
# day-to-day work but not ACL administration (create tokens, write policies,
# manage auth methods). For those, mint a management token out of band (e.g. via
# Vault) or keep the bootstrap token as offline break-glass.
#
# Prereqs, done once in the Pocket-ID admin UI (https://id.falconindy.com):
#
#   1. Create an OIDC client named "Nomad".
#   2. Set its callback / redirect URLs to BOTH of these (UI login + CLI login):
#        https://nomad.service.home:4646/ui/settings/tokens
#        http://localhost:4649/oidc/callback
#   3. (recommended) Restrict the client to an allowed group so only you can use
#      it — that is how access is gated, since the binding rule below has no
#      selector and applies to everyone who authenticates through this client.
#   4. Copy the generated client ID and secret and export them before running:
#        export OIDC_CLIENT_ID=...
#        export OIDC_CLIENT_SECRET=...
#
# Run with a management token (the bootstrap token, for now):
#   export NOMAD_TOKEN=<management-token>
#   OIDC_CLIENT_ID=... OIDC_CLIENT_SECRET=... bin/nomad-build-oidc

set -euo pipefail

export NOMAD_ADDR=${NOMAD_ADDR:-https://nomad.service.home:4646}

: "${OIDC_CLIENT_ID:?set OIDC_CLIENT_ID (from the Pocket-ID client)}"
: "${OIDC_CLIENT_SECRET:?set OIDC_CLIENT_SECRET (from the Pocket-ID client)}"

script_dir=$(cd "$(dirname "$0")" && pwd)
repo_root=$(cd "$script_dir/.." && pwd)

# Ensure the admin policy exists (upsert; safe to re-run).
nomad acl policy apply -description "day-to-day admin" admin "$repo_root/nomad-admin.hcl"

# Auth method config goes in a temp file so the client secret stays out of the
# process arguments. Clean it up on exit.
cfg=$(mktemp)
chmod 600 "$cfg"
trap 'rm -f "$cfg"' EXIT
cat >"$cfg" <<JSON
{
  "OIDCDiscoveryURL": "https://id.falconindy.com",
  "OIDCClientID": "${OIDC_CLIENT_ID}",
  "OIDCClientSecret": "${OIDC_CLIENT_SECRET}",
  "OIDCScopes": ["openid", "profile"],
  "OIDCEnablePKCE": true,
  "BoundAudiences": ["${OIDC_CLIENT_ID}"],
  "AllowedRedirectURIs": [
    "https://nomad.service.home:4646/ui/settings/tokens",
    "http://localhost:4649/oidc/callback"
  ]
}
JSON

# Create or update the auth method (idempotent). Default + global so it's the
# method `nomad login` picks and the token works across regions.
# `create` takes -name as a flag; `update` takes the name as a positional arg.
if nomad acl auth-method list -json | grep -q '"Name": *"pocket-id"'; then
  nomad acl auth-method update \
    -type=OIDC \
    -default=true \
    -token-name-format="\${auth_method_type}-\${auth_method_name}" \
    -max-token-ttl=8h \
    -token-locality=global \
    -config=@"$cfg" \
    pocket-id
else
  nomad acl auth-method create \
    -name=pocket-id \
    -type=OIDC \
    -default=true \
    -token-name-format="\${auth_method_type}-\${auth_method_name}" \
    -max-token-ttl=8h \
    -token-locality=global \
    -config=@"$cfg"
fi

# Bind everyone who authenticates through the Pocket-ID client to the admin
# policy. Access is gated on the Pocket-ID side (allowed group on the client),
# so no selector is needed. Created only if absent.
if ! nomad acl binding-rule list -json | grep -q '"AuthMethod": *"pocket-id"'; then
  nomad acl binding-rule create \
    -auth-method=pocket-id -bind-type=policy -bind-name=admin \
    -description="pocket-id -> admin policy"
fi

echo
echo "Nomad OIDC configured. Test it:"
echo "    nomad login -method=pocket-id"
echo "    nomad acl token self    # Policies should list 'admin', Type = client"

# ---------------------------------------------------------------------------
# Want admin-ness decided in Nomad from a Pocket-ID group instead of on the
# client? Add "groups" to OIDCScopes, add  "ListClaimMappings": {"groups":
# "roles"}  to the config, and create the binding rule with a selector:
#   nomad acl binding-rule create -auth-method=pocket-id -bind-type=policy \
#     -bind-name=admin -selector='"nomad-admins" in list.roles'
# ---------------------------------------------------------------------------
