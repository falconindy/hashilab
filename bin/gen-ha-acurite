#!/usr/bin/env python3

"""Regenerate homeassistant/packages/package_acurite.yaml from DEVICES below.

Each Acurite-Tower unit publishes temperature_C, humidity, and battery_ok on
rtl_433/Acurite-Tower/<id> over MQTT; this renders the matching temperature/
humidity/battery-low mqtt entities and writes the package file. Add a device
by adding a tuple to DEVICES and re-running.

Entity IDs are pinned via default_entity_id to <slug>_acurite_<kind>. HA only
applies it when an entity is first registered, so changing a slug here does not
rename an existing entity -- rename it in the entity registry to match.

Usage:
  bin/gen-ha-acurite
"""

from pathlib import Path

import yaml

DEVICES = [
    # (id, slug)
    (14279, "marasroom"),
    (12057, "mainbath"),
    (6652, "mainbed"),
    (2153, "livingroom"),
    (6640, "office"),
    (9106, "basement"),
]

OUT_PATH = (
    Path(__file__).resolve().parent.parent
    / "homeassistant"
    / "packages"
    / "package_acurite.yaml"
)


def build_entries():
    entries = []
    for device_id, slug in DEVICES:
        topic = f"rtl_433/Acurite-Tower/{device_id}"
        device = {  # shared object -> pyyaml emits &anchor / *alias automatically
            "identifiers": [f"acurite_{device_id}"],
            "manufacturer": "Acurite",
            "model": "06044M",
            "name": "Acurite",
        }
        entries += [
            {
                "sensor": {
                    "name": "Temperature",
                    "default_entity_id": f"sensor.{slug}_acurite_temperature",
                    "device_class": "temperature",
                    "unit_of_measurement": "°C",
                    "value_template": "{{ value_json.temperature_C | round(1) }}",
                    "state_topic": topic,
                    "state_class": "measurement",
                    "unique_id": f"acurite_temperature_{device_id}",
                    "device": device,
                }
            },
            {
                "sensor": {
                    "name": "Humidity",
                    "default_entity_id": f"sensor.{slug}_acurite_humidity",
                    "device_class": "humidity",
                    "unit_of_measurement": "%",
                    "value_template": "{{ value_json.humidity }}",
                    "state_topic": topic,
                    "state_class": "measurement",
                    "unique_id": f"acurite_humidity_{device_id}",
                    "device": device,
                }
            },
            {
                "binary_sensor": {
                    "name": "Battery",
                    "default_entity_id": f"binary_sensor.{slug}_acurite_battery",
                    "device_class": "battery",
                    "state_topic": topic,
                    "value_template": "{{ 'OFF' if value_json.battery_ok else 'ON' }}",
                    "unique_id": f"acurite_battery_{device_id}",
                    "device": device,
                }
            },
        ]
    return entries


class PrettierDumper(yaml.SafeDumper):
    """Match prettier's YAML style so the output is committed as-is."""

    def increase_indent(self, flow=False, indentless=False):
        # Indent block sequences under their parent key.
        return super().increase_indent(flow, False)

    def choose_scalar_style(self):
        # Prefer double quotes wherever pyyaml would single-quote.
        style = super().choose_scalar_style()
        return '"' if style == "'" else style


def main():
    doc = {"mqtt": build_entries()}
    OUT_PATH.write_text(
        yaml.dump(
            doc,
            Dumper=PrettierDumper,
            sort_keys=False,
            allow_unicode=True,
            width=float("inf"),
        )
    )


if __name__ == "__main__":
    main()
