{
  "uid": "hashilab-log-explorer",
  "title": "Logs — Explorer",
  "tags": ["logs", "victorialogs", "nomad"],
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "time": { "from": "now-1h", "to": "now" },
  "refresh": "30s",
  "templating": {
    "list": [
      {
        "name": "search",
        "label": "Search (LogsQL)",
        "type": "textbox",
        "query": "*",
        "current": { "text": "*", "value": "*" }
      },
      {
        "name": "filters",
        "label": "Filter",
        "type": "adhoc",
        "datasource": {
          "type": "victoriametrics-logs-datasource",
          "uid": "victorialogs"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Log volume by job",
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "victorialogs"
      },
      "gridPos": { "h": 8, "w": 16, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60,
            "lineWidth": 0,
            "stacking": { "mode": "normal", "group": "A" }
          },
          "color": { "mode": "palette-classic" }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": ["sum"]
        },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "victorialogs"
          },
          "expr": "${search}",
          "queryType": "hits",
          "fields": ["nomad_job"]
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Total log lines",
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "victorialogs"
      },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "blue", "value": null }]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "victorialogs"
          },
          "expr": "${search} | stats count() as total",
          "queryType": "stats"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Errors by job",
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "victorialogs"
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60,
            "lineWidth": 0,
            "stacking": { "mode": "normal", "group": "A" }
          },
          "color": { "mode": "palette-classic" }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "victorialogs"
          },
          "expr": "${search} error",
          "queryType": "hits",
          "fields": ["nomad_job"]
        }
      ]
    },
    {
      "id": 4,
      "type": "table",
      "title": "Top jobs by volume",
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "victorialogs"
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "options": {
        "showHeader": true,
        "sortBy": [{ "displayName": "logs", "desc": true }]
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "victorialogs"
          },
          "expr": "${search} | stats by (nomad_job) count() as logs",
          "queryType": "stats"
        }
      ]
    },
    {
      "id": 5,
      "type": "logs",
      "title": "Logs",
      "description": "Each line is prefixed with its stream labels (nomad_job, node, …). Click a line to expand fields and use the filter buttons, or add a chip in the Filter bar at the top.",
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "victorialogs"
      },
      "gridPos": { "h": 13, "w": 24, "x": 0, "y": 16 },
      "options": {
        "showTime": true,
        "showLabels": true,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "sortOrder": "Descending"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "victorialogs"
          },
          "expr": "${search}",
          "queryType": "instant",
          "maxLines": 1000
        }
      ]
    }
  ]
}
