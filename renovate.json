{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "docker:enableMajor"],
  "commitMessagePrefix": ":arrow_up:",
  "packageRules": [
    {
      "matchPackageNames": ["busybox"],
      "enabled": false
    },
    {
      "matchPackageNames": ["postgres"],
      "matchUpdateTypes": ["minor", "patch"]
    },
    {
      "matchPackageNames": ["postgres"],
      "matchUpdateTypes": ["major"],
      "enabled": false
    },
    {
      "matchPackageNames": ["linuxserver/deluge"],
      "matchUpdateTypes": ["minor", "patch", "release"]
    },
    {
      "matchPackageNames": ["linuxserver/deluge"],
      "matchUpdateTypes": ["major"],
      "enabled": false
    }
  ],
  "customManagers": [
    {
      "description": "Update container images in Nomad Job (.hcl) files",
      "customType": "regex",
      "datasourceTemplate": "docker",
      "managerFilePatterns": ["/jobs/.+\\.hcl$/"],
      "matchStrings": [
        "\\s*image\\s*=\\s*\\\"(?<depName>.*?):([a-z0-9]+-)?(?<currentValue>.*?)\\\""
      ]
    },
    {
      "description": "Update CNI plugins version in Nomad role defaults",
      "customType": "regex",
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "containernetworking/plugins",
      "extractVersionTemplate": "^v(?<version>.+)$",
      "managerFilePatterns": ["/roles/nomad/defaults/main\\.yml$"],
      "matchStrings": [
        "nomad_cni_plugins_version:\\s*\"(?<currentValue>[^\"]+)\""
      ]
    },
    {
      "description": "Update geoblock Traefik plugin version in traefik-ingress job",
      "customType": "regex",
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "PascalMinder/geoblock",
      "extractVersionTemplate": "^v(?<version>.+)$",
      "managerFilePatterns": ["/jobs/traefik-ingress\\.hcl$/"],
      "matchStrings": ["geoblock-(?<currentValue>[\\d.]+):"]
    }
  ]
}
