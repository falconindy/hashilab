{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "packageRules": [
    {
      "matchPackageNames": ["postgres"],
      "allowedVersions": "/^17\\..+/"
    },
    {
      "matchPackageNames": ["linuxserver/deluge"],
      "allowedVersions": "/^amd64-.+$/"
    },
    {
      "matchPackageNames": ["linuxserver/jellyfin"],
      "allowedVersions": "/^\\d{2}\\./"
    }
  ],
  "customManagers": [
    {
      "description": "Update container images in Nomad Job (.hcl) files",
      "customType": "regex",
      "datasourceTemplate": "docker",
      "fileMatch": [
        "jobs/.+\\.hcl$"
      ],
      "matchStrings": [
        "\\s*image\\s*=\\s*\\\"(?<depName>.*?):([a-z0-9]+-)?(?<currentValue>.*?)\\\""
      ]
    }
  ]
}
