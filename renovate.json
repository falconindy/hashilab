{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "docker:enableMajor"
  ],
  "commitMessagePrefix": ":arrow_up:",
  "packageRules": [
    {
      "matchPackageNames": [
        "busybox"
      ],
      "enabled": false
    },
    {
      "matchPackageNames": [
        "postgres"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ]
    },
    {
      "matchPackageNames": [
        "postgres"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "enabled": false
    },
    {
      "matchPackageNames": [
        "deluge"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ]
    },
    {
      "matchPackageNames": [
        "deluge"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "enabled": false
    },
    {
      "versioning": "regex:^(?<compatibility>.*?)-(?<major>v?\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)[\\.-]*r?(?<build>\\d+)*-*r?(?<release>\\w+)*",
      "matchPackageNames": [
        "/^ghcr.io\\/linuxserver\\//"
      ]
    }
  ],
  "customManagers": [
    {
      "description": "Update container images in Nomad Job (.hcl) files",
      "customType": "regex",
      "datasourceTemplate": "docker",
      "managerFilePatterns": [
        "/jobs/.+\\.hcl$/"
      ],
      "matchStrings": [
        "\\s*image\\s*=\\s*\\\"(?<depName>.*?):([a-z0-9]+-)?(?<currentValue>.*?)\\\""
      ]
    }
  ]
}
