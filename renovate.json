{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "packageRules": [
    {
      "matchPackageNames": ["postgres"],
      "allowedVersions": "/^17\\..+/"
    },
    {
      "matchPackageNames": ["linuxserver/deluge"],
      "allowedVersions": "/^amd64-.+$/"
    },
    {
      "matchPackageNames": ["linuxserver/jellyfin"],
      "allowedVersions": "/^\\d{2}\\./"
    }
  ],
  "customManagers": [
    {
      "description": "Update container images in Nomad Job (.hcl) files",
      "customType": "regex",
      "datasourceTemplate": "docker",
      "fileMatch": [
        "jobs/.+\\.hcl$"
      ],
      "matchStrings": [
        "\\s*image\\s*=\\s*\\\"(?<depName>.*?):([a-z0-9]+-)?(?<currentValue>.*?)\\\""
      ]
    },
    {
      "description": "Update container images in Podman Quadlet (.container) files",
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker",
      "fileMatch": [
        "podman/.+\\.container$"
      ],
      "matchStrings": [
        "(?<indentation>\\n\\s*)Image\\s*=\\s*(?<depName>[a-zA-Z0-9/._-]+)(?::(?<currentValue>[a-zA-Z0-9._-]+))?(?:@(?<currentDigest>sha256:[a-f0-9]+))?"
      ],
      "matchStringsStrategy": "any",
      "autoReplaceStringTemplate": "{{{indentation}}}Image={{{depName}}}{{#if newValue}}:{{{newValue}}}{{/if}}{{#if newDigest}}@{{{newDigest}}}{{/if}}"
    }
  ]
}
