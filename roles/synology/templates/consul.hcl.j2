datacenter = "global"

data_dir = "/volume1/consul/var/lib/consul"

domain = "home."
alt_domain = "consul."

# Live gossip key from Vault KV (kv/consul/gossip); only used to bootstrap a
# from-scratch agent — running agents rotate via `consul keyring` (see RUNBOOK).
encrypt = "{{ synology_consul_gossip_key }}"
encrypt_verify_incoming = true
encrypt_verify_outgoing = true

# nasty is a bare client: auto_encrypt gets its RPC cert from the servers
# (auto-rotated, no provisioning), and it serves no HTTP/gRPC (ports below all
# -1), so there's no manually-managed leaf to deliver — only the static CA (the
# synology role writes home-ca.pem) to verify the servers on connect.
auto_encrypt {
  tls = true
}

tls {
  defaults {
    verify_incoming        = false
    verify_outgoing        = true
    verify_server_hostname = true

    ca_file = "/volume1/consul/etc/consul.d/home-ca.pem"
  }
}

acl {
  # Stage 2: agent token is now provisioned (the `tokens.agent` below), matching
  # the Debian fleet. default_policy stays "allow" until the whole cluster is
  # verified; flip to "deny" (Stage 4) fleet-wide, not per-node.
  enabled                  = true
  default_policy           = "allow"
  down_policy              = "extend-cache"
  enable_token_persistence = true

  # agent: the NAS's own identity for anti-entropy (node registration + catalog
  # sync); carries the consul-agent policy (node write, service read).
  # config_file_service_registration: authorizes registration of the NAS's
  # config-file service (nas); carries the consul-config-services policy
  # (service:write on that named service). Both minted by tofu
  # (module.consul_acl), stashed in Vault KV, and read on the controller side —
  # see the "Read the Consul ... token" tasks in the synology role.
  tokens {
    agent                            = "{{ synology_consul_agent_token }}"
    config_file_service_registration = "{{ synology_consul_config_services_token }}"
  }
}

# RPC (8300, auto_encrypt cert) and gossip stay — all a bare client needs.
# https + grpc_tls are TLS listeners that used the now-removed cert_file, so they
# must go with it; grpc/http are unused too (nasty runs no Envoy, and the API is
# reached via the servers over consul.service.home).
ports {
  http     = -1
  https    = -1
  grpc     = -1
  grpc_tls = -1
}

server = false
enable_syslog = true

client_addr = "0.0.0.0"
{# GetInterfaceIP is consul's own go-sockaddr template, rendered at runtime;
   {% raw %} stops Ansible's Jinja from touching it. #}
bind_addr      = "{% raw %}{{ GetInterfaceIP \"bond0\" }}{% endraw %}"
advertise_addr = "{% raw %}{{ GetInterfaceIP \"bond0\" }}{% endraw %}"

retry_join = {{ groups["consul_servers"] | map('extract', hostvars, 'ansible_host') | list | to_json }}

services {
  id   = "nas"
  name = "nas"
  port = 5000
  tags = [
    "traefik.enable=true",
  ]

  check {
    id       = "synology"
    name     = "synology-dsm"
    tcp      = "localhost:5000"
    interval = "10s"
  }
}

telemetry {
  disable_hostname          = true
  prometheus_retention_time = "72h"
}
