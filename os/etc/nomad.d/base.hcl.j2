# Full configuration options can be found at https://developer.hashicorp.com/nomad/docs/configuration

data_dir  = "/opt/nomad/data"
bind_addr = "0.0.0.0"
datacenter = "{{ nomad_datacenter }}"

advertise {
  http = "{{ '{{' }} GetInterfaceIP \"{{ ansible_default_ipv4.interface }}\" {{ '}}' }}:4646"
  rpc  = "{{ '{{' }} GetInterfaceIP \"{{ ansible_default_ipv4.interface }}\" {{ '}}' }}:4647"
  serf = "{{ '{{' }} GetInterfaceIP \"{{ ansible_default_ipv4.interface }}\" {{ '}}' }}:4648"
}

ui {
  enabled = true

  consul {
    ui_url = "https://consul.service.home:8501/ui"
  }

  vault {
    ui_url = "https://vault.service.home:8200/ui"
  }
}

tls {
  http = true
  rpc  = true

  ca_file   = "/opt/nomad/tls/home-ca.pem"
  cert_file = "/opt/nomad/tls/tls.crt"
  key_file  = "/opt/nomad/tls/tls.key"

  verify_server_hostname = true
  verify_https_client    = false
}

consul {
  address              = "localhost:8500"
  auto_advertise       = true
  checks_use_advertise = true

  server_auto_join = true
  client_auto_join = true
}

acl {
  enabled = true
}

vault {
  enabled = true
  address = "https://vault.service.home:8200"

  create_from_role = "nomad-cluster"

  default_identity {
    aud  = ["vault.io"]
    env  = true
    file = true
    ttl  = "1h"
  }
}

telemetry {
  disable_hostname = true
  prometheus_metrics = true
  publish_allocation_metrics = true
  publish_node_metrics = true
  use_node_name = false
}

plugin "raw_exec" {
  config {
    enabled = true
  }
}

plugin "docker" {
  config {
    allow_privileged = true
    allow_caps       = ["ALL"]

    volumes {
      enabled = "true"
    }
  }
}

plugin "nomad-driver-podman" {
  config {
    volumes {
      enabled = "true"
    }
  }
}
