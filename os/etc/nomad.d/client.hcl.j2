# Client configuration options can be found at https://developer.hashicorp.com/nomad/docs/configuration/client

client {
  enabled = true

  max_kill_timeout = "30s"

{# Nomad fingerprints the N100's base freq (800MHz x4 = 3200), a 4x
   underestimate. PL1=20W lets all 4 cores hold the 3.4GHz turbo, so the real
   ceiling is 4 * 3400 = 13600. Key this off the CPU model rather than the
   hostname so new nodes of a known model pick it up automatically. #}
{% set cpu_compute_by_model = {"N100": 13600} %}
{% set _cpu_models = ansible_facts["processor"] | join(" ") %}
{% set _ns = namespace(compute=0) %}
{% for _model, _compute in cpu_compute_by_model.items() %}
{%   if _model in _cpu_models %}{% set _ns.compute = _compute %}{% endif %}
{% endfor %}
{% if _ns.compute %}
  cpu_total_compute = {{ _ns.compute }}

{% endif %}
  gc_interval              = "1m"
  gc_disk_usage_threshold  = 80
  gc_inode_usage_threshold = 70
  gc_parallel_destroys     = 2

  meta {
{% for hwcap in nomad_hardware_capabilities %}
    has_{{ hwcap }} = "true"
{% endfor %}
{% if 'vault_servers' in group_names %}
    has_vault = "true"
{% endif %}
  }
}

ui {
  enabled = true

  consul {
    ui_url = "https://consul.service.home:8501/ui"
  }

  vault {
    ui_url = "{{ vault_addr }}/ui"
  }
}

plugin "raw_exec" {
  config {
    enabled = true
  }
}

plugin "docker" {
  config {
    allow_privileged = true
    allow_caps       = ["ALL"]

    # Stamp each container with its Nomad identity so the Vector log shipper can
    # turn these into Loki labels (com.hashicorp.nomad.<name>).
    extra_labels = ["job_name", "task_group_name", "task_name", "namespace", "node_name"]

    volumes {
      enabled = "true"
    }
  }
}
