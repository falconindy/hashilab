vrrp_instance VI_1 {
  # all nodes considered equal.
  state BACKUP

  # avoid "fighting" over the VIP
  nopreempt

  # only used as a tie-breaker
  priority {{ ansible_default_ipv4.address.split('.')[3]}}

  interface {{ ansible_facts.default_ipv4.alias }}
  virtual_router_id 51

  advert_int 1

  authentication {
    auth_type PASS
    auth_pass 45507f63
  }

  virtual_ipaddress {
    10.0.100.109/24 dev {{ ansible_facts.default_ipv4.alias }}
  }

  # Allow packets addressed to the VIPs above to be received
  accept
}

virtual_server 10.0.100.109 {
  delay_loop 6
  lb_algo rr
  lb_kind NAT
  protocol TCP

{% for host in groups["keepalived_servers"] %}
  real_server {{ hostvars[host]['ansible_default_ipv4']['address'] }} 80 {
    weight 1

    HTTP_GET {
      url {
          path /ping
          status_code 200
      }

      connect_timeout 2
      retry 2
      delay_before_retry 2
    }
  }
{% endfor %}
}
