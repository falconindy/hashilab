# Full configuration options can be found at https://www.consul.io/docs/agent/config

datacenter = "global"

data_dir      = "/opt/consul"
enable_syslog = true
log_level     = "WARN"

domain     = "home."
alt_domain = "consul."

# not the real gossip key -- managed via `consul keyring`.
encrypt                 = "zCRKj1wD/rj5Mq747hHufzT/SN1RzHRiR4Kcr0KYQrQ="
encrypt_verify_incoming = true
encrypt_verify_outgoing = true

client_addr    = "0.0.0.0"
advertise_addr = "{{ ansible_host }}"
bind_addr      = "{{ ansible_host }}"
retry_join     = {{ groups["consul_servers"] | map('extract', hostvars, 'ansible_host') | list | to_json }}

enable_local_script_checks = true

auto_encrypt {
{% if 'consul_servers' in group_names %}
  allow_tls = true
{% else %}
  tls = true
{% endif %}
}

tls {
  defaults {
    verify_incoming        = true
    verify_outgoing        = true
    verify_server_hostname = true

    ca_file   = "/etc/ssl/certs/home.pem"
    cert_file = "/etc/consul.d/server.crt"
    key_file  = "/etc/consul.d/server.key"
  }
  https {
    verify_incoming = false
  }
  grpc {
    verify_incoming = false
  }
}

acl {
  # Stage 2: agent tokens are now provisioned (the `tokens.agent` below), but
  # default_policy stays "allow" until Nomad workload identity and Vault
  # registration are verified across the fleet. Flip to "deny" (Stage 4) only
  # then — otherwise the cluster fails closed.
  enabled                  = true
  default_policy           = "allow"
  down_policy              = "extend-cache"
  enable_token_persistence = true

  # The agent's own identity for anti-entropy (node registration + catalog
  # sync). Minted by tofu (module.consul_acl), stashed in Vault KV, and read on
  # the controller side above — see the "Read the Consul agent token" task in
  # the consul role. Carries the consul-agent policy (node write, service read).
  tokens {
    agent = "{{ consul_agent_token }}"
  }
}

http_config {
  response_headers {
    "Access-Control-Expose-Headers" = "X-Consul-Index, X-Consul-Knownleader, X-Consul-Lastcontact"
  }
}

ports {
  http     = -1
  https    = 8501
  grpc     = -1
  grpc_tls = 8503
}

connect {
  enabled = true
}

telemetry {
  disable_hostname          = true
  prometheus_retention_time = "72h"
}
