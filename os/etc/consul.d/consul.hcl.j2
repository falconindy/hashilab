# Full configuration options can be found at https://www.consul.io/docs/agent/config

datacenter = "global"

data_dir      = "/opt/consul"
enable_syslog = true
log_level     = "WARN"

{% if "dc1" in group_names %}
server             = true
bootstrap_expect   = 3
leave_on_terminate = true
{% endif %}

domain     = "home."
alt_domain = "consul."

encrypt                 = "zCRKj1wD/rj5Mq747hHufzT/SN1RzHRiR4Kcr0KYQrQ="
encrypt_verify_incoming = true
encrypt_verify_outgoing = true

client_addr    = "0.0.0.0"
advertise_addr = "{{ '{{' }} GetInterfaceIP \"{{ ansible_default_ipv4.interface }}\" {{ '}}' }}"
bind_addr      = "{{ '{{' }} GetInterfaceIP \"{{ ansible_default_ipv4.interface }}\" {{ '}}' }}"
retry_join     = ["10.0.100.100", "10.0.100.101", "10.0.100.102"]

enable_local_script_checks = true

tls {
  defaults {
    verify_incoming        = true
    verify_outgoing        = true
    verify_server_hostname = true

    ca_file   = "/opt/shared/tls/home-ca.pem"
    cert_file = "/opt/consul/tls/tls.crt"
    key_file  = "/opt/consul/tls/tls.key"
  }
  https {
    verify_incoming = false
  }
  grpc {
    verify_incoming = false
  }
}

{% if "dc1" in group_names %}
auto_encrypt {
  allow_tls = true
}

{% endif %}
ui_config {
  enabled = true
}

http_config {
  response_headers {
    Access-Control-Allow-Origin = "*"
  }
}

ports {
  http     = 8500
  https    = 8501
  grpc     = -1
  grpc_tls = 8503
}

connect {
  enabled = true
}

telemetry {
  disable_hostname = true
  prometheus_retention_time = "72h"
}

service {
  id = "consul-client"
  name = "consul-client"
  port = 8501

  check {
    id = "consul-client"
    name = "Consul HTTPS"
    http = "https://localhost:8501/v1/status/leader"
    interval = "10s"
    timeout = "1s"
  }
}
