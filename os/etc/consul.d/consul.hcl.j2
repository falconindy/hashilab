# Full configuration options can be found at https://www.consul.io/docs/agent/config

datacenter = "global"

data_dir      = "/opt/consul"
enable_syslog = true
log_level     = "WARN"

domain     = "home."
alt_domain = "consul."

# not the real gossip key -- managed via `consul keyring`.
encrypt                 = "zCRKj1wD/rj5Mq747hHufzT/SN1RzHRiR4Kcr0KYQrQ="
encrypt_verify_incoming = true
encrypt_verify_outgoing = true

client_addr    = "0.0.0.0"
advertise_addr = "{{ ansible_default_ipv4.address }}"
bind_addr      = "{{ ansible_default_ipv4.address }}"
retry_join     = {{ groups["consul_servers"] | map('extract', hostvars, 'ansible_host') | list | to_json }}

enable_local_script_checks = true

tls {
  defaults {
    verify_incoming        = true
    verify_outgoing        = true
    verify_server_hostname = true

    ca_file   = "/etc/ssl/certs/home.pem"
    cert_file = "/etc/consul.d/tls.crt"
    key_file  = "/etc/consul.d/tls.key"
  }
  https {
    verify_incoming = false
  }
  grpc {
    verify_incoming = false
  }
}

ports {
  http     = 8500
  https    = 8501
  grpc     = -1
  grpc_tls = 8503
}

connect {
  enabled = true
}

telemetry {
  disable_hostname = true
  prometheus_retention_time = "72h"
}
